{
    "name": "1994/sign-off-statamic",
    "description": "Multi-step editorial sign-off for Statamic Pro: editors submit changes for review, each step approves or rejects with comments, and nothing goes live until everyone has signed off.",
    "type": "statamic-addon",
    "license": "proprietary",
    "keywords": [
        "statamic",
        "statamic-addon",
        "workflow",
        "approval",
        "review",
        "editorial"
    ],
    "authors": [
        {
            "name": "1994",
            "email": "hello@1994.co.uk",
            "homepage": "https://1994.co.uk"
        }
    ],
    "support": {
        "email": "hello@1994.co.uk"
    },
    "autoload": {
        "psr-4": {
            "NineteenNinetyFour\\SignOff\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NineteenNinetyFour\\SignOff\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "extra": {
        "statamic": {
            "name": "Sign-off",
            "description": "Multi-step editorial sign-off for Statamic Pro. Nothing goes live until everyone has signed off.",
            "developer": "1994",
            "developer-url": "https://1994.co.uk"
        },
        "laravel": {
            "providers": [
                "NineteenNinetyFour\\SignOff\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
